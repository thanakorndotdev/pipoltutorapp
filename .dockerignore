# Host-side artifacts must never enter an image: macOS native modules
# segfault Bun inside the alpine build stage.
**/node_modules
**/.next
**/out
**/.git
**/.env
**/.env.*
!**/.env.example
# Runtime data belongs in volumes, never in an image or its build context.
backend/app/cert-keys
backend/app/certificates
backend/app/uploads
**/*.pem
