# Site address comes from SITE_ADDRESS in docker/.env (default: localhost).
# Production: SITE_ADDRESS="pipoltutor.org, www.pipoltutor.org" — Caddy then
# fetches Let's Encrypt certs for each name once DNS points at this server.
{$SITE_ADDRESS:localhost} {
    encode zstd gzip

    # Forward all API traffic to ElysiaJS backend; handle_path strips the
    # /api prefix so the backend keeps its bare routes (/health, /orders, ...).
    handle_path /api/* {
        reverse_proxy backend:3001
    }

    # Admin dashboard: static export baked into the caddy image
    # (caddy.Dockerfile) at /srv/admin. Built with basePath /admin, so the
    # files under /srv/admin have no /admin prefix — handle_path strips it.
    redir /admin /admin/ 308
    handle_path /admin/* {
        root * /srv/admin
        try_files {path} {path}/index.html {path}.html
        file_server
    }

    # Forward all other traffic to Next.js frontend
    handle {
        reverse_proxy frontend:3000
    }
}
