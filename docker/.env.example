# Copy to docker/.env and fill in a real password:
#   cp docker/.env.example docker/.env
# docker/.env is the single source of DB credentials — compose reads it
# automatically, and backend/app/src/db/env.ts reads it for host-side
# drizzle-kit / seed runs.
POSTGRES_USER=bun_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app_db

# Host port Postgres is published on (bound to 127.0.0.1 only).
POSTGRES_PORT=5432

# Port the backend listens on, inside the container and behind Caddy.
BACKEND_PORT=3001

# 1 lets the backend accept the x-dev-user-email header as a login, so checkout
# can be exercised before Google OAuth exists. Never 1 in production.
ALLOW_DEV_AUTH=0

# Bootstrap admins: comma-separated emails. The users.role column (admin /
# dev / test / student) is the source of truth; anyone listed here is treated
# as admin and gets role=admin on first Google sign-in. Every other sign-up is
# a student until promoted in the dashboard (ผู้ใช้และสิทธิ์).
ADMIN_EMAILS=

# Static key for the admin settings page and scripts, sent as x-admin-key.
# Generate with: openssl rand -hex 32. Empty disables the header.
ADMIN_API_KEY=

# Google OAuth (Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID, type "Web application"). Add these Authorized redirect URIs:
#   http://localhost:3000/api/auth/google/callback   (host dev loop)
#   https://localhost/api/auth/google/callback        (docker + Caddy)
#   https://<your-domain>/api/auth/google/callback    (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Origin the browser uses. Builds the OAuth redirect_uri and marks the session
# cookie Secure when https. Host dev: http://localhost:3000. Docker: https://localhost.
PUBLIC_URL=http://localhost:3000
# Compose ignores PUBLIC_URL and uses this for the container (default https://localhost).
# PUBLIC_URL_DOCKER=https://your-domain.example

# Omise (Opn Payments) — dashboard.omise.co → Keys. Test keys start with
# pkey_test_ / skey_test_. Webhook endpoint to register in the dashboard:
#   <PUBLIC_URL>/api/webhooks/omise
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
